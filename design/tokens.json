{
  "$description": "Kitchen OS v3.0 Design Tokens, W3C DTCG Format 2025.10. Quiet Luxury Operational Aesthetic.",
  "color": {
    "$type": "color",
    "bg": {
      "base":         { "$value": { "colorSpace": "srgb", "components": [0.9804, 0.9804, 0.9804], "hex": "#fafafa" } },
      "surface":      { "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#ffffff" } },
      "card":         { "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#ffffff" } },
      "cardHover":    { "$value": { "colorSpace": "srgb", "components": [0.9647, 0.9647, 0.9725], "hex": "#f6f6f8" } },
      "cardSelected": { "$value": { "colorSpace": "srgb", "components": [0.9294, 0.9333, 0.9451], "hex": "#edeff1" } },
      "cardPressed":  { "$value": { "colorSpace": "srgb", "components": [0.898, 0.902, 0.9176], "hex": "#e5e6ea" } },
      "overlay":      { "$value": { "colorSpace": "srgb", "components": [0.9608, 0.9608, 0.9686], "hex": "#f5f5f7" } }
    },
    "border": {
      "subtle":      { "$value": { "colorSpace": "srgb", "components": [0.898, 0.9059, 0.9216], "hex": "#e5e7eb" } },
      "interactive": { "$value": { "colorSpace": "srgb", "components": [0.8196, 0.8353, 0.8588], "hex": "#d1d5db" } },
      "strong":      { "$value": { "colorSpace": "srgb", "components": [0.6118, 0.6392, 0.6863], "hex": "#9ca3af" } }
    },
    "text": {
      "primary":   { "$value": { "colorSpace": "srgb", "components": [0.0667, 0.0941, 0.1529], "hex": "#111827" } },
      "secondary": { "$value": { "colorSpace": "srgb", "components": [0.2157, 0.2549, 0.3176], "hex": "#374151" } },
      "dim":       { "$value": { "colorSpace": "srgb", "components": [0.3686, 0.4078, 0.4706], "hex": "#5e6878" } },
      "onAccent":  { "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#ffffff" } },
      "onDanger":  { "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#ffffff" } }
    },
    "accent": {
      "primary": { "$value": { "colorSpace": "srgb", "components": [0.3529, 0.0941, 0.1529], "hex": "#5a1827" } },
      "hover":   { "$value": { "colorSpace": "srgb", "components": [0.2745, 0.0706, 0.1176], "hex": "#46121e" } },
      "pressed": { "$value": { "colorSpace": "srgb", "components": [0.2196, 0.0549, 0.0941], "hex": "#380e18" } }
    },
    "danger": { "$value": { "colorSpace": "srgb", "components": [0.7765, 0.1412, 0.1412], "hex": "#c62424" } }
  },
  "status": {
    "$type": "color",
    "success":  { "$value": { "colorSpace": "srgb", "components": [0.0863, 0.6392, 0.2902], "hex": "#16a34a" }, "$extensions": { "com.software-company.label": "תקין" } },
    "warning":  { "$value": { "colorSpace": "srgb", "components": [0.851, 0.4667, 0.0235], "hex": "#d97706" }, "$extensions": { "com.software-company.label": "אזהרה" } },
    "critical": { "$value": { "colorSpace": "srgb", "components": [0.8627, 0.149, 0.149], "hex": "#dc2626" }, "$extensions": { "com.software-company.label": "חריגה" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans":   { "$value": ["Heebo", "Segoe UI", "Arial", "sans-serif"] },
      "hebrew": { "$value": ["Heebo", "Segoe UI", "Rubik", "Arial", "sans-serif"] }
    },
    "size": {
      "$type": "dimension",
      "title":   { "$value": { "value": 24, "unit": "px" } },
      "heading": { "$value": { "value": 18, "unit": "px" } },
      "body":    { "$value": { "value": 14, "unit": "px" } },
      "caption": { "$value": { "value": 12, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "strong":  { "$value": 600 }
    },
    "lineHeight": {
      "body": { "$type": "number", "$value": 1.5 }
    }
  },
  "space": {
    "$type": "dimension",
    "base": { "$value": { "value": 8, "unit": "px" } },
    "xxs":  { "$value": { "value": 2, "unit": "px" } },
    "xs":   { "$value": { "value": 4, "unit": "px" } },
    "sm":   { "$value": { "value": 8, "unit": "px" } },
    "md":   { "$value": { "value": 16, "unit": "px" } },
    "lg":   { "$value": { "value": 24, "unit": "px" } },
    "xl":   { "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm":   { "$value": { "value": 6, "unit": "px" } },
    "md":   { "$value": { "value": 10, "unit": "px" } },
    "lg":   { "$value": { "value": 16, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "motion": {
    "$extensions": { "com.software-company.reducedMotion": "fade-only" },
    "duration": {
      "$type": "duration",
      "micro":     { "$value": { "value": 150, "unit": "ms" } },
      "component": { "$value": { "value": 220, "unit": "ms" } },
      "screen":    { "$value": { "value": 300, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0.0, 0.0, 1.0] },
      "enter":    { "$value": [0.0, 0.0, 0.2, 1.0] },
      "exit":     { "$value": [0.4, 0.0, 1.0, 1.0] }
    }
  },
  "focus": {
    "ring": {
      "color": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1176, 0.1176, 0.1176], "hex": "#1e1e1e" } },
      "width": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } }
    }
  }
}
