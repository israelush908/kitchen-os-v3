{
  "$description": "Kitchen OS v3.0 Design Tokens, W3C DTCG Format 2025.10. Swiss Kitchen Editorial Aesthetic.",
  "color": {
    "$type": "color",
    "bg": {
      "base":         { "$value": { "colorSpace": "srgb", "components": [0.9725, 0.9686, 0.9569], "hex": "#F8F7F4" } },
      "surface":      { "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF" } },
      "card":         { "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF" } },
      "cardHover":    { "$value": { "colorSpace": "srgb", "components": [0.949, 0.9412, 0.9176], "hex": "#F2F0EA" } },
      "cardSelected": { "$value": { "colorSpace": "srgb", "components": [0.9373, 0.9647, 1.0], "hex": "#EFF6FF" } },
      "cardPressed":  { "$value": { "colorSpace": "srgb", "components": [0.898, 0.8902, 0.8627], "hex": "#E5E3DC" } },
      "overlay":      { "$value": { "colorSpace": "srgb", "components": [0.9725, 0.9686, 0.9569], "hex": "#F8F7F4" } }
    },
    "border": {
      "subtle":      { "$value": { "colorSpace": "srgb", "components": [0.8392, 0.8275, 0.7882], "hex": "#D6D3C9" } },
      "interactive": { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0667, 0.0824], "hex": "#0F1115" } },
      "strong":      { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0667, 0.0824], "hex": "#0F1115" } }
    },
    "text": {
      "primary":   { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0667, 0.0824], "hex": "#0F1115" } },
      "secondary": { "$value": { "colorSpace": "srgb", "components": [0.2941, 0.3333, 0.3882], "hex": "#4B5563" } },
      "dim":       { "$value": { "colorSpace": "srgb", "components": [0.3922, 0.4549, 0.5451], "hex": "#64748B" } },
      "onAccent":  { "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF" } },
      "onDanger":  { "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF" } }
    },
    "accent": {
      "primary": { "$value": { "colorSpace": "srgb", "components": [0.9176, 0.3451, 0.0471], "hex": "#EA580C" } },
      "hover":   { "$value": { "colorSpace": "srgb", "components": [0.8, 0.2863, 0.0], "hex": "#CC4900" } },
      "pressed": { "$value": { "colorSpace": "srgb", "components": [0.6824, 0.2431, 0.0], "hex": "#AE3E00" } },
      "cobalt":  { "$value": { "colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1D4ED8" } }
    },
    "danger": { "$value": { "colorSpace": "srgb", "components": [0.7255, 0.1098, 0.1098], "hex": "#B91C1C" } }
  },
  "status": {
    "$type": "color",
    "success":  { "$value": { "colorSpace": "srgb", "components": [0.0824, 0.502, 0.2392], "hex": "#15803D" }, "$extensions": { "com.software-company.label": "תקין" } },
    "warning":  { "$value": { "colorSpace": "srgb", "components": [0.7059, 0.3255, 0.0353], "hex": "#B45309" }, "$extensions": { "com.software-company.label": "אזהרה" } },
    "critical": { "$value": { "colorSpace": "srgb", "components": [0.7255, 0.1098, 0.1098], "hex": "#B91C1C" }, "$extensions": { "com.software-company.label": "חוסר" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans":   { "$value": ["Rubik", "Heebo", "Segoe UI", "Arial", "sans-serif"] },
      "hebrew": { "$value": ["Rubik", "Heebo", "Segoe UI", "Arial", "sans-serif"] },
      "mono":   { "$value": ["Space Mono", "JetBrains Mono", "Consolas", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "title":   { "$value": { "value": 24, "unit": "px" } },
      "heading": { "$value": { "value": 18, "unit": "px" } },
      "body":    { "$value": { "value": 16, "unit": "px" } },
      "caption": { "$value": { "value": 12, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium":  { "$value": 500 },
      "strong":  { "$value": 700 }
    },
    "lineHeight": {
      "body": { "$type": "number", "$value": 1.45 }
    }
  },
  "space": {
    "$type": "dimension",
    "base": { "$value": { "value": 8, "unit": "px" } },
    "xxs":  { "$value": { "value": 2, "unit": "px" } },
    "xs":   { "$value": { "value": 4, "unit": "px" } },
    "sm":   { "$value": { "value": 8, "unit": "px" } },
    "md":   { "$value": { "value": 16, "unit": "px" } },
    "lg":   { "$value": { "value": 24, "unit": "px" } },
    "xl":   { "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "badge": { "$value": { "value": 4, "unit": "px" } },
    "sm":    { "$value": { "value": 6, "unit": "px" } },
    "md":    { "$value": { "value": 6, "unit": "px" } },
    "lg":    { "$value": { "value": 12, "unit": "px" } },
    "full":  { "$value": { "value": 9999, "unit": "px" } }
  },
  "motion": {
    "$extensions": { "com.software-company.reducedMotion": "fade-only" },
    "duration": {
      "$type": "duration",
      "micro":     { "$value": { "value": 120, "unit": "ms" } },
      "component": { "$value": { "value": 200, "unit": "ms" } },
      "screen":    { "$value": { "value": 240, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0.0, 0.0, 1.0] },
      "enter":    { "$value": [0.0, 0.0, 0.2, 1.0] },
      "exit":     { "$value": [0.4, 0.0, 1.0, 1.0] }
    }
  },
  "focus": {
    "ring": {
      "color": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1D4ED8" } },
      "width": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } }
    }
  }
}
